{
  "dataset": {
    "repo_id": "local/g1d_bottles_merged_filtered_absolute",
    "root": "/data/datasets/g1d_bottles_merged_filtered_absolute",
    "eval_split": 0.0,
    "streaming": false,
    "video_backend": "torchcodec",
    "image_transforms": {
      "enable": false
    }
  },
  "policy": {
    "type": "flux3",
    "trunk_weights": "black-forest-labs/flux-3-action-base:flux-3-action-base.safetensors",
    "conditioning": "frame",
    "action_representation": "absolute",
    "use_relative_actions": false,
    "normalization_mapping": {
      "ACTION": "QUANTILES",
      "STATE": "QUANTILES",
      "VISUAL": "IDENTITY"
    },
    "camera_layout": "grid",
    "camera_keys": [
      "observation.images.head_camera",
      "observation.images.left_wrist_camera",
      "observation.images.right_wrist_camera"
    ],
    "device": "cuda",
    "dtype": "float32",
    "use_peft": false,
    "push_to_hub": false,
    "attn_mode": "torch",
    "compile_model": false,
    "gradient_checkpointing": true,
    "caption_dropout": 0.1,
    "augment": false,
    "optimizer_lr": 5e-05,
    "optimizer_lr_heads_multiplier": 1.0,
    "optimizer_betas": [
      0.9,
      0.99
    ],
    "optimizer_eps": 1e-08,
    "optimizer_weight_decay": 0.05,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_freeze_backbone_steps": 0,
    "scheduler_warmup_steps": 800,
    "scheduler_warmup_steps_heads": 800,
    "scheduler_decay_steps": 0,
    "scheduler_cooldown_steps": 0
  },
  "peft": null,
  "ema": {
    "enable": false
  },
  "parallelism": {
    "dp_replicate": 1,
    "dp_shard": 8
  },
  "accelerator": {
    "mixed_precision": "bf16",
    "gradient_accumulation": {
      "steps": 4
    },
    "fsdp": {
      "wrap_modules": [
        "ModeBlock",
        "SingleStreamBlock"
      ],
      "reshard_after_forward": true,
      "cpu_offload": false
    }
  },
  "batch_size": 16,
  "steps": 40000,
  "seed": 42,
  "num_workers": 8,
  "prefetch_factor": 2,
  "persistent_workers": true,
  "dataloader_multiprocessing_context": "spawn",
  "use_policy_training_preset": true,
  "log_freq": 40,
  "env_eval_freq": 0,
  "eval_steps": 0,
  "max_eval_samples": 2048,
  "save_checkpoint": true,
  "save_freq": 10000,
  "checkpoint_format": "safetensors_dcp",
  "save_checkpoint_to_hub": false,
  "wandb": {
    "enable": true,
    "project": "pickplace",
    "disable_artifact": true
  },
  "job_name": "flux3_g1d_bottles_merged_filtered_absolute_fsdp_lerobot_batch16",
  "output_dir": "/data/outputs/flux3_g1d_bottles_merged_filtered_absolute_fsdp_lerobot_batch16"
}
