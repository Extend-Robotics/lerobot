{
  "dataset": {
    "repo_id": "leyland_merged_500",
    "root": "datasets/leyland_merged_500"
  },
  "policy": {
    "type": "pi05",
    "pretrained_path": "lerobot/pi05_base",
    "normalization_mapping": {
      "ACTION": "MEAN_STD",
      "STATE": "MEAN_STD",
      "VISUAL": "IDENTITY"
    },
    "n_action_steps": 10,
    "optimizer_lr": 2.5e-05,
    "optimizer_betas": [
        0.9,
        0.95
    ],
    "optimizer_eps": 1e-08,
    "optimizer_weight_decay": 0.01,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_warmup_steps": 1000,
    "scheduler_decay_steps": 100000,
    "scheduler_decay_lr": 2.5e-06,
    "empty_cameras": 1,
    "freeze_vision_encoder": false,
    "train_expert_only": false,
    "gradient_checkpointing": true,
    "compile_model": true,
    "dtype": "bfloat16",
    "rtc_training_max_delay": 5,
    "device": "cuda",
    "push_to_hub": false
  },
  "accelerator": {
    "mixed_precision": "bf16"
  },
  "output_dir": "outputs/pi05_leyland_merged_500",
  "job_name": "pi05_leyland_merged_500",
  "batch_size": 64,
  "num_workers": 8,
  "steps": 100000,
  "save_freq": 10000,
  "seed": 1000,
  "wandb": {
    "enable": true,
    "disable_artifact": true,
    "project": "pickplace"
    
  }
}
