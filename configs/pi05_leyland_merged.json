{
  "dataset": {
    "repo_id": "leyland_merged",
    "root": "datasets/leyland_merged"
  },
  "policy": {
    "type": "pi05",
    "pretrained_path": "lerobot/pi05_base",
    "normalization_mapping": {
      "ACTION": "MEAN_STD",
      "STATE": "MEAN_STD",
      "VISUAL": "IDENTITY"
    },
    "n_action_steps": 10,
    "optimizer_lr": 2.5e-05,
    "optimizer_betas": [
        0.9,
        0.95
    ],
    "optimizer_eps": 1e-08,
    "optimizer_weight_decay": 0.01,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_warmup_steps": 1000,
    "scheduler_decay_steps": 50000,
    "scheduler_decay_lr": 2.5e-06,
    "empty_cameras": 1,
    "freeze_vision_encoder": true,
    "train_expert_only": false,
    "gradient_checkpointing": true,
    "compile_model": true,
    "dtype": "bfloat16",
    "rtc_training_max_delay": 5,
    "device": "cuda",
    "push_to_hub": false
  },
  "accelerator": {
    "mixed_precision": "bf16"
  },
  "peft": {
    "method_type": "LORA",
    "r": 32,
    "lora_alpha": 64,
    "target_modules": ".*\\.paligemma\\.model\\.language_model\\..*\\.self_attn\\.(q|v)_proj",
    "full_training_modules": [
      "model.paligemma_with_expert.gemma_expert",
      "model.action_in_proj",
      "model.action_out_proj",
      "model.time_mlp_in",
      "model.time_mlp_out"
    ]
  },
  "output_dir": "outputs/pi05_leyland_merged",
  "job_name": "pi05_leyland_merged",
  "batch_size": 32,
  "num_workers": 8,
  "steps": 50000,
  "save_freq": 5000,
  "seed": 1000,
  "wandb": {
    "enable": true,
    "disable_artifact": true,
    "project": "pickplace"
    
  }
}
