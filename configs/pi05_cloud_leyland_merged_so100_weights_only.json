{
  "dataset": {
    "repo_id": "leyland_merged_500",
    "root": "datasets/leyland_merged_500"
  },
  "policy": {
    "type": "pi05",
    "pretrained_path": "hqfang/pi05-so100_101",
    "normalization_mapping": {
      "ACTION": "QUANTILES",
      "STATE": "QUANTILES",
      "VISUAL": "IDENTITY"
    },
    "n_action_steps": 10,
    "optimizer_lr": 2.5e-05,
    "optimizer_betas": [
      0.9,
      0.95
    ],
    "optimizer_eps": 1e-08,
    "optimizer_weight_decay": 0.01,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_warmup_steps": 1000,
    "scheduler_decay_steps": 50000,
    "scheduler_decay_lr": 2.5e-06,
    "empty_cameras": 1,
    "freeze_vision_encoder": false,
    "train_expert_only": false,
    "gradient_checkpointing": true,
    "compile_model": false,
    "dtype": "bfloat16",
    "rtc_training_max_delay": 0,
    "device": "cuda",
    "push_to_hub": false,
    "chunk_size": 50,
    "use_relative_actions": false,
    "text_tokenizer_name": "google/paligemma-3b-pt-224",
    "pretrained_revision": "d3204e03ae84d232e2493a933fd460515904eb58"
  },
  "accelerator": {
    "mixed_precision": "bf16"
  },
  "output_dir": "outputs/pi05_cloud_leyland_merged_500_so100_weights_only",
  "job_name": "pi05_cloud_leyland_merged_500_so100_weights_only",
  "batch_size": 32,
  "num_workers": 8,
  "steps": 50000,
  "save_freq": 5000,
  "seed": 1000,
  "wandb": {
    "enable": true,
    "disable_artifact": true,
    "project": "pickplace"
  },
  "load_pretrained_processors": false
}
