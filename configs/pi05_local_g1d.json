{
  "dataset": {
    "repo_id": "local/g1_pico_combined",
    "root": "datasets/g1_pico_combined",
    "eval_split": 0.0,
    "image_transforms": {
      "enable": true,
      "max_num_transforms": 2,
      "random_order": false,
      "tfs": {
        "brightness": {
          "type": "ColorJitter",
          "kwargs": {"brightness": [0.8, 1.2]}
        },
        "contrast": {
          "type": "ColorJitter",
          "kwargs": {"contrast": [0.8, 1.2]}
        }
      }
    }
  },
  "policy": {
    "type": "pi05",
    "pretrained_path": "lerobot/pi05_base",
    "normalization_mapping": {
      "ACTION": "QUANTILES",
      "STATE": "QUANTILES",
      "VISUAL": "IDENTITY"
    },
    "chunk_size": 50,
    "n_action_steps": 10,
    "max_state_dim": 32,
    "max_action_dim": 32,
    "use_relative_actions": true,
    "relative_exclude_joints": ["left_hand.", "right_hand."],
    "optimizer_lr": 2.5e-05,
    "optimizer_betas": [
      0.9,
      0.95
    ],
    "optimizer_eps": 1e-08,
    "optimizer_weight_decay": 0.01,
    "optimizer_grad_clip_norm": 1.0,
    "scheduler_warmup_steps": 1000,
    "scheduler_decay_steps": 40000,
    "scheduler_decay_lr": 2.5e-06,
    "empty_cameras": 0,
    "freeze_vision_encoder": true,
    "train_expert_only": false,
    "gradient_checkpointing": true,
    "compile_model": true,
    "compile_mode": "default",
    "dtype": "bfloat16",
    "rtc_training_max_delay": 10,
    "device": "cuda",
    "push_to_hub": false
  },
  "accelerator": {
    "mixed_precision": "bf16",
    "gradient_accumulation": {
      "steps": 4
    }
  },
  "peft": {
    "method_type": "LORA",
    "r": 128,
    "lora_alpha": 256,
    "target_modules": ".*\\.paligemma\\.model\\.language_model\\..*\\.self_attn\\.(q|v)_proj",
    "full_training_modules": [
      "model.paligemma_with_expert.gemma_expert",
      "model.action_in_proj",
      "model.action_out_proj",
      "model.time_mlp_in",
      "model.time_mlp_out"
    ]
  },
  "output_dir": "outputs/pi05_g1d_50",
  "job_name": "pi05_g1d_50",
  "batch_size": 32,
  "num_workers": 8,
  "steps": 40000,
  "eval_steps": 0,
  "env_eval_freq": 0,
  "save_freq": 4000,
  "seed": 1000,
  "wandb": {
    "enable": true,
    "disable_artifact": true,
    "project": "pickplace"
  }
}
